<UserControl
    x:Class="MoneyTalk.App.Controls.KpiCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource CardBorderStyle}" MinWidth="200">
        <StackPanel Spacing="4">
            <TextBlock x:Name="LabelBlock" Style="{StaticResource KpiLabelStyle}" />
            <TextBlock x:Name="ValueBlock" Style="{StaticResource KpiValueStyle}" Foreground="{x:Bind AccentBrush, Mode=OneWay}" />
            <TextBlock x:Name="SubTextBlock" Style="{StaticResource MutedTextStyle}" />
        </StackPanel>
    </Border>
</UserControl>
