<Application
    x:Class="MoneyTalk.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:MoneyTalk.App.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="MoneyTalkAccentBrush" Color="#2F7D5B" />
            <SolidColorBrush x:Key="MoneyTalkPositiveBrush" Color="#2E8B57" />
            <SolidColorBrush x:Key="MoneyTalkNegativeBrush" Color="#C0392B" />
            <SolidColorBrush x:Key="MoneyTalkWarningBrush" Color="#D68910" />

            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:StringToBoolConverter x:Key="StringToBoolConverter" />
            <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
            <conv:CurrencyConverter x:Key="CurrencyConverter" />
            <conv:SignedCurrencyBrushConverter x:Key="SignedCurrencyBrushConverter" />
            <conv:ShortDateConverter x:Key="ShortDateConverter" />
            <conv:InsightSeverityToInfoBarSeverityConverter x:Key="InsightSeverityToInfoBarSeverityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
