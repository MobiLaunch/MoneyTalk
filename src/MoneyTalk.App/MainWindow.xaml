<Window
    x:Class="MoneyTalk.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid x:Name="RootGrid">
    <Grid.KeyboardAccelerators>
        <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="CommandPaletteAccelerator_Invoked" />
    </Grid.KeyboardAccelerators>

    <NavigationView
        x:Name="RootNavigationView"
        IsBackButtonVisible="Auto"
        IsSettingsVisible="False"
        SelectionChanged="RootNavigationView_SelectionChanged"
        BackRequested="RootNavigationView_BackRequested"
        Loaded="RootNavigationView_Loaded"
        PaneTitle="MoneyTalk">

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Dashboard" Tag="Dashboard" Icon="Home" />

            <NavigationViewItem Content="Chart of Accounts" Tag="ChartOfAccounts" Icon="AllApps" />
            <NavigationViewItem Content="General Ledger" Tag="Journal" Icon="List" />

            <NavigationViewItem Content="Customers" Tag="Customers" Icon="ContactInfo" />
            <NavigationViewItem Content="Invoices" Tag="Invoices" Icon="PostUpdate" />
            <NavigationViewItem Content="Repair Tickets" Tag="Tickets" Icon="Repair" />
            <NavigationViewItem Content="Point of Sale" Tag="Pos" Icon="Shop" />
            <NavigationViewItem Content="Calendar" Tag="Calendar" Icon="Calendar" />
            <NavigationViewItem Content="Vendor Repairs" Tag="VendorRepairs" Icon="Send" />
            <NavigationViewItem Content="Trade-Ins" Tag="TradeIns" Icon="Switch" />
            <NavigationViewItem Content="Device Triage" Tag="DeviceTriage" Icon="Admin" />

            <NavigationViewItem Content="Vendors" Tag="Vendors" Icon="People" />
            <NavigationViewItem Content="Bills" Tag="Bills" Icon="Document" />

            <NavigationViewItem Content="Products &amp; Services" Tag="Items" Icon="Tag" />

            <NavigationViewItem Content="Bank Accounts" Tag="BankAccounts" Icon="Account" />
            <NavigationViewItem Content="Reconciliation" Tag="Reconciliation" Icon="Sync" />

            <NavigationViewItem Content="Budgets" Tag="Budgets" Icon="Calculator" />
            <NavigationViewItem Content="Recurring Transactions" Tag="RecurringTransactions" Icon="Refresh" />

            <NavigationViewItem Content="Reports" Tag="Reports" Icon="Page2" />
            <NavigationViewItem Content="AI Assistant" Tag="AiAssistant" Icon="Message" />
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Integrations" Tag="Integrations" Icon="Link" />
            <NavigationViewItem Content="Company Settings" Tag="CompanySettings" Icon="Setting" />
            <NavigationViewItem Content="Users" Tag="Users" Icon="Contact" />
        </NavigationView.FooterMenuItems>

        <Frame x:Name="ContentFrame" />
    </NavigationView>

    <Grid x:Name="LockOverlay" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Visibility="Collapsed">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Width="280">
            <TextBlock Text="MoneyTalk is locked" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <PasswordBox x:Name="LockPinBox" PlaceholderText="Enter PIN" MaxLength="6" KeyDown="LockPinBox_KeyDown" />
            <Button Content="Unlock" HorizontalAlignment="Stretch" Click="UnlockButton_Click" />
            <TextBlock x:Name="LockErrorText" Text="Incorrect PIN." Foreground="{StaticResource MoneyTalkNegativeBrush}" HorizontalAlignment="Center" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
  </Grid>
</Window>
