<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MoneyTalk.App</RootNamespace>
    <AssemblyName>MoneyTalk.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Must be true even though we don't ship MSIX: with `dotnet build` (as opposed to full
         Visual Studio), the Windows App SDK's PRI-resource-generation task only resolves
         correctly when this is enabled. Leaving it false throws MSB4062
         ("Microsoft.Build.Packaging.Pri.Tasks.ExpandPriContent task could not be loaded") — a
         documented WindowsAppSDK CLI-build quirk, not something that forces MSIX packaging.
         Actual packaging output is controlled by WindowsPackageType below, not this. -->
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- MoneyTalk ships unpackaged (no MSIX) so it can be built and run without provisioning
         signing certificates or app-store style packaging identity — just build and run the
         .exe, same as any other Win32 desktop app. Set WindowsAppSDKSelfContained to true below
         if you want to xcopy-deploy without requiring the Windows App SDK runtime to be
         separately installed on the target machine. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="CommunityToolkit.WinUI.UI.Controls.DataGrid" Version="7.1.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MoneyTalk.Core\MoneyTalk.Core.csproj" />
    <ProjectReference Include="..\MoneyTalk.Data\MoneyTalk.Data.csproj" />
    <ProjectReference Include="..\MoneyTalk.Integrations.Square\MoneyTalk.Integrations.Square.csproj" />
    <ProjectReference Include="..\MoneyTalk.Integrations.QuickBooks\MoneyTalk.Integrations.QuickBooks.csproj" />
    <ProjectReference Include="..\MoneyTalk.Integrations.Gemini\MoneyTalk.Integrations.Gemini.csproj" />
  </ItemGroup>

</Project>
