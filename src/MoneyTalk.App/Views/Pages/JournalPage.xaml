<Page
    x:Class="MoneyTalk.App.Views.Pages.JournalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="using:CommunityToolkit.WinUI.Controls">

    <Grid Padding="24" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1.2*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="General Ledger" Style="{StaticResource PageTitleStyle}" Margin="0" />
            <dg:DataGrid Grid.Row="1" ItemsSource="{Binding Entries}" AutoGenerateColumns="False"
                         IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                <dg:DataGrid.Columns>
                    <dg:DataGridTextColumn Header="#" Binding="{Binding EntryNumber}" Width="60" />
                    <dg:DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="110" />
                    <dg:DataGridTextColumn Header="Memo" Binding="{Binding Memo}" Width="2*" />
                    <dg:DataGridTextColumn Header="Source" Binding="{Binding SourceType}" Width="120" />
                    <dg:DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                    <dg:DataGridTextColumn Header="Amount" Binding="{Binding Total}" Width="110" />
                </dg:DataGrid.Columns>
            </dg:DataGrid>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Stretch">
            <StackPanel Spacing="12">
                <TextBlock Text="New Manual Journal Entry" Style="{StaticResource SectionHeaderStyle}" />
                <InfoBar IsOpen="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" Severity="Error" Message="{Binding ErrorMessage}" />

                <DatePicker Header="Date" Date="{Binding NewEntryDate, Mode=TwoWay}" />
                <TextBox Header="Memo" Text="{Binding NewEntryMemo, Mode=TwoWay}" />

                <Button Content="Add Line" Click="AddLine_Click" HorizontalAlignment="Left" />

                <dg:DataGrid ItemsSource="{Binding NewEntryLines}" AutoGenerateColumns="False" IsReadOnly="True"
                             HeadersVisibility="Column" MinHeight="140" MaxHeight="240">
                    <dg:DataGrid.Columns>
                        <dg:DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="2*" />
                        <dg:DataGridTextColumn Header="Debit" Binding="{Binding Debit}" Width="*" />
                        <dg:DataGridTextColumn Header="Credit" Binding="{Binding Credit}" Width="*" />
                        <dg:DataGridTemplateColumn Header="" Width="40">
                            <dg:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" Click="RemoveLine_Click" Tag="{Binding}" />
                                </DataTemplate>
                            </dg:DataGridTemplateColumn.CellTemplate>
                        </dg:DataGridTemplateColumn>
                    </dg:DataGrid.Columns>
                </dg:DataGrid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding NewEntryDebitTotalDisplay}" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="1" Text="{Binding NewEntryCreditTotalDisplay}" HorizontalAlignment="Right" />
                </Grid>

                <Button Content="Post Journal Entry" Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding PostNewEntryCommand}" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
