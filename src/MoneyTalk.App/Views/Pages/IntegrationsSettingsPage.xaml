<Page
    x:Class="MoneyTalk.App.Views.Pages.IntegrationsSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoneyTalk.App.Controls">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20" MaxWidth="720">
            <TextBlock Text="Integrations" Style="{StaticResource PageTitleStyle}" Margin="0" />
            <controls:BusyErrorBar IsBusy="{Binding IsBusy}" ErrorMessage="{Binding ErrorMessage}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Gemini AI Advisor" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="Get a free API key at aistudio.google.com/apikey, then paste it below to enable the AI Assistant page." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="✓ A Gemini API key is saved." Foreground="{StaticResource MoneyTalkPositiveBrush}" Visibility="{Binding HasGeminiKey, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <PasswordBox Header="Gemini API key" Password="{Binding GeminiApiKeyInput, Mode=TwoWay}" />
                    <Button Content="Save Key" Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveGeminiKeyCommand}" HorizontalAlignment="Left" />

                    <TextBox Header="Model" Text="{Binding GeminiModelIdInput, Mode=TwoWay}" PlaceholderText="gemini-2.5-flash" />
                    <TextBlock Text="Google periodically retires/renames Gemini models. If the AI Assistant starts failing with a 404 'model no longer available' error, check aistudio.google.com for the current model id and paste it here." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <Button Content="Save Model" Command="{Binding SaveGeminiModelCommand}" HorizontalAlignment="Left" />

                    <TextBlock Text="{Binding GeminiStatusMessage}" Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Square" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="✓ Connected" Foreground="{StaticResource MoneyTalkPositiveBrush}" Visibility="{Binding SquareIsConnected, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="Register a free app at developer.squareup.com/apps, then paste its Client ID/Secret here." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <TextBox Header="Client ID" Text="{Binding SquareClientIdInput, Mode=TwoWay}" />
                    <PasswordBox Header="Client secret" Password="{Binding SquareClientSecretInput, Mode=TwoWay}" />
                    <TextBox Header="Redirect URL" Text="{Binding SquareRedirectUriInput, Mode=TwoWay}"
                             PlaceholderText="https://your-relay.workers.dev/square/callback" />
                    <TextBlock Text="This must be the deployed oauth-relay URL (see /oauth-relay in the repo) — it also needs to be entered as the Redirect URL in Square's dashboard, exactly matching." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <ToggleSwitch Header="Use Sandbox (test) credentials" IsOn="{Binding SquareUseSandboxInput, Mode=TwoWay}"
                                  OnContent="Sandbox" OffContent="Production" />
                    <TextBlock Text="This must match the tab your Client ID/Secret came from in the Square dashboard — mixing Sandbox credentials with Production (or vice versa) is the most common cause of 400/401 errors here." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <Button Content="Save App Credentials" Command="{Binding SaveSquareAppCredentialsCommand}" HorizontalAlignment="Left" />

                    <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}">
                        1. Click "Open Square Authorization" — approve access in your browser.
                        2. Copy the authorization code the relay page displays.
                        3. Paste it below and click Connect.
                    </TextBlock>
                    <Button Content="Open Square Authorization" Click="OpenSquareAuth_Click" HorizontalAlignment="Left" />
                    <TextBox Header="Authorization code" Text="{Binding SquareAuthCodeInput, Mode=TwoWay}" />
                    <Button Content="Connect Square" Style="{StaticResource AccentButtonStyle}" Command="{Binding CompleteSquareConnectionCommand}" HorizontalAlignment="Left" />

                    <ComboBox Header="Deposit Square payments into" ItemsSource="{Binding BankAccounts}"
                              SelectedItem="{Binding SelectedSquareDepositAccount, Mode=TwoWay}" DisplayMemberPath="BankName" HorizontalAlignment="Stretch" />
                    <Button Content="Sync Last 30 Days of Payments" Command="{Binding SyncSquareCommand}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding SquareStatusMessage}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />

                    <TextBlock Text="Activity (Last 30 Days)" Style="{StaticResource SectionHeaderStyle}" />
                    <Button Content="Load Square Activity" Command="{Binding LoadSquareActivityCommand}" HorizontalAlignment="Left"
                            Visibility="{Binding SquareIsConnected, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Grid ColumnSpacing="16" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Revenue" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{Binding SquareTotalRevenueDisplay}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Text="Tips" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{Binding SquareTotalTipsDisplay}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Processing Fees" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{Binding SquareTotalFeesDisplay}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="Net Revenue" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{Binding SquareNetRevenueDisplay}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="Payouts" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{Binding SquareTotalPayoutsDisplay}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="Orders" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{Binding SquareOrdersCountDisplay}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="QuickBooks Online" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="✓ Connected" Foreground="{StaticResource MoneyTalkPositiveBrush}" Visibility="{Binding QuickBooksIsConnected, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="Register a free app at developer.intuit.com, then paste its Client ID/Secret here." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <TextBox Header="Client ID" Text="{Binding QuickBooksClientIdInput, Mode=TwoWay}" />
                    <PasswordBox Header="Client secret" Password="{Binding QuickBooksClientSecretInput, Mode=TwoWay}" />
                    <TextBox Header="Redirect URL" Text="{Binding QuickBooksRedirectUriInput, Mode=TwoWay}"
                             PlaceholderText="https://your-relay.workers.dev/quickbooks/callback" />
                    <TextBlock Text="This must be the deployed oauth-relay URL (see /oauth-relay in the repo) — it also needs to be entered as a Redirect URI in Intuit's developer portal, exactly matching." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <ToggleSwitch Header="Use Sandbox (test company) credentials" IsOn="{Binding QuickBooksUseSandboxInput, Mode=TwoWay}"
                                  OnContent="Sandbox" OffContent="Production" />
                    <TextBlock Text="This must match the app/company you're actually connecting to — mixing a Sandbox company with Production credentials (or vice versa) is the most common cause of 400/401 errors here." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <Button Content="Save App Credentials" Command="{Binding SaveQuickBooksAppCredentialsCommand}" HorizontalAlignment="Left" />

                    <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}">
                        1. Click "Open QuickBooks Authorization" — sign in and approve access.
                        2. Copy the authorization code and realm id the relay page displays.
                        3. Paste both below and click Connect.
                    </TextBlock>
                    <Button Content="Open QuickBooks Authorization" Click="OpenQuickBooksAuth_Click" HorizontalAlignment="Left" />
                    <TextBox Header="Authorization code" Text="{Binding QuickBooksAuthCodeInput, Mode=TwoWay}" />
                    <TextBox Header="Realm ID (company id)" Text="{Binding QuickBooksRealmIdInput, Mode=TwoWay}" />
                    <Button Content="Connect QuickBooks" Style="{StaticResource AccentButtonStyle}" Command="{Binding CompleteQuickBooksConnectionCommand}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding QuickBooksStatusMessage}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Email Notifications" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="Enter your shop's own SMTP account (a Gmail app password, Office 365, or any other mail server) to send ticket/appointment notifications." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Header="SMTP host" Text="{Binding EmailHostInput, Mode=TwoWay}" PlaceholderText="smtp.gmail.com" />
                        <NumberBox Grid.Column="1" Header="Port" Value="{Binding EmailPortInput, Mode=TwoWay}" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Inline" />
                    </Grid>
                    <TextBox Header="Username" Text="{Binding EmailUsernameInput, Mode=TwoWay}" />
                    <PasswordBox Header="Password / app password" Password="{Binding EmailPasswordInput, Mode=TwoWay}" />
                    <ToggleSwitch Header="Use SSL/STARTTLS" IsOn="{Binding EmailUseSslInput, Mode=TwoWay}" />
                    <TextBox Header="From address" Text="{Binding EmailFromAddressInput, Mode=TwoWay}" />
                    <TextBox Header="From name" Text="{Binding EmailFromNameInput, Mode=TwoWay}" />
                    <Button Content="Save Email Settings" Command="{Binding SaveEmailSettingsCommand}" HorizontalAlignment="Left" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Header="Send a test email to" Text="{Binding EmailTestRecipientInput, Mode=TwoWay}" Width="260" />
                        <Button Content="Send Test Email" VerticalAlignment="Bottom" Command="{Binding SendTestEmailCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding EmailStatusMessage}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
