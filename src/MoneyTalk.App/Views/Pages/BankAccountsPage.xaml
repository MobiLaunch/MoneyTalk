<Page
    x:Class="MoneyTalk.App.Views.Pages.BankAccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="using:CommunityToolkit.WinUI.UI.Controls">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Bank Accounts" Style="{StaticResource PageTitleStyle}" Margin="0" />
            <Button Grid.Column="1" Content="Import CSV Statement" Margin="0,0,8,0" Click="ImportCsv_Click" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Link Bank Account" Style="{StaticResource AccentButtonStyle}" Click="AddBankAccount_Click" VerticalAlignment="Center" />
        </Grid>

        <InfoBar Grid.Row="1" IsOpen="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" Severity="Error" Message="{Binding ErrorMessage}" />

        <dg:DataGrid Grid.Row="2" ItemsSource="{Binding BankAccounts}" AutoGenerateColumns="False"
                     IsReadOnly="True" SelectedItem="{Binding SelectedBankAccount, Mode=TwoWay}"
                     GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <dg:DataGrid.Columns>
                <dg:DataGridTextColumn Header="Bank Name" Binding="{Binding BankName}" Width="200" />
                <dg:DataGridTextColumn Header="Linked GL Account" Binding="{Binding LinkedAccountName}" Width="220" />
                <dg:DataGridTextColumn Header="Balance" Binding="{Binding CurrentBalance}" Width="140" />
                <dg:DataGridTextColumn Header="Last Reconciled" Binding="{Binding LastReconciledDate}" Width="150" />
            </dg:DataGrid.Columns>
        </dg:DataGrid>
    </Grid>
</Page>
