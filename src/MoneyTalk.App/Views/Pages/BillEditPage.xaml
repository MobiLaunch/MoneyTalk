<Page
    x:Class="MoneyTalk.App.Views.Pages.BillEditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="1000">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Bill" Style="{StaticResource PageTitleStyle}" Margin="0" />
                <Button Grid.Column="1" Content="Back" Command="{Binding GoBackCommand}" />
            </Grid>

            <InfoBar IsOpen="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" Severity="Error" Message="{Binding ErrorMessage}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ComboBox Grid.Row="0" Grid.Column="0" Header="Vendor" ItemsSource="{Binding Vendors}"
                              SelectedItem="{Binding SelectedVendor, Mode=TwoWay}" DisplayMemberPath="Name"
                              IsEnabled="{Binding IsUnposted}" HorizontalAlignment="Stretch" />
                    <TextBox Grid.Row="0" Grid.Column="1" Header="Bill #" Text="{Binding BillNumber, Mode=TwoWay}" IsEnabled="{Binding IsUnposted}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Status}" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />

                    <DatePicker Grid.Row="1" Grid.Column="0" Header="Bill date" Date="{Binding BillDate, Mode=TwoWay}" IsEnabled="{Binding IsUnposted}" />
                    <DatePicker Grid.Row="1" Grid.Column="1" Header="Due date" Date="{Binding DueDate, Mode=TwoWay}" IsEnabled="{Binding IsUnposted}" />
                    <TextBox Grid.Row="1" Grid.Column="2" Header="Memo" Text="{Binding Memo, Mode=TwoWay}" IsEnabled="{Binding IsUnposted}" />
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Line Items" Style="{StaticResource SectionHeaderStyle}" />
                <Button Grid.Column="1" Content="Add Line" Click="AddLine_Click" IsEnabled="{Binding IsUnposted}" />
            </Grid>

            <dg:DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" HeadersVisibility="Column"
                         GridLinesVisibility="Horizontal" MinHeight="120" MaxHeight="300" CanUserSortColumns="False">
                <dg:DataGrid.Columns>
                    <dg:DataGridTextColumn Header="Description" Binding="{Binding Description, Mode=TwoWay}" Width="3*" />
                    <dg:DataGridTextColumn Header="Qty" Binding="{Binding Quantity, Mode=TwoWay}" Width="*" />
                    <dg:DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, Mode=TwoWay}" Width="*" />
                    <dg:DataGridTextColumn Header="Amount" Binding="{Binding Amount}" IsReadOnly="True" Width="*" />
                    <dg:DataGridTemplateColumn Header="" Width="60">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✕" Click="RemoveLine_Click" Tag="{Binding}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>
                </dg:DataGrid.Columns>
            </dg:DataGrid>

            <StackPanel HorizontalAlignment="Right" Spacing="4" MinWidth="240">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Total" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding TotalDisplay}" FontWeight="SemiBold" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Paid" />
                    <TextBlock Grid.Column="1" Text="{Binding AmountPaidDisplay}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Balance Due" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding BalanceDisplay}" FontWeight="SemiBold" />
                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Save &amp; Post Bill" Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveAndPostCommand}"
                        Visibility="{Binding IsUnposted, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button Content="Record Payment" Style="{StaticResource AccentButtonStyle}" Click="RecordPayment_Click"
                        Visibility="{Binding CanRecordPayment, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>

            <ProgressRing IsActive="{Binding IsBusy}" HorizontalAlignment="Right" />
        </StackPanel>
    </ScrollViewer>
</Page>
