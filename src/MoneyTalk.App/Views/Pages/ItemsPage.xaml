<Page
    x:Class="MoneyTalk.App.Views.Pages.ItemsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="using:CommunityToolkit.WinUI.Controls">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Products &amp; Services" Style="{StaticResource PageTitleStyle}" Margin="0" />
            <Button Grid.Column="1" Content="Add Item" Style="{StaticResource AccentButtonStyle}" Click="AddItem_Click" VerticalAlignment="Center" />
        </Grid>

        <InfoBar Grid.Row="1" IsOpen="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" Severity="Error" Message="{Binding ErrorMessage}" />

        <dg:DataGrid Grid.Row="2" ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                     IsReadOnly="True" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <dg:DataGrid.Columns>
                <dg:DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100" />
                <dg:DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" />
                <dg:DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120" />
                <dg:DataGridTextColumn Header="Sales Price" Binding="{Binding SalesPrice}" Width="120" />
                <dg:DataGridTextColumn Header="Cost" Binding="{Binding Cost}" Width="120" />
                <dg:DataGridTextColumn Header="Qty on Hand" Binding="{Binding QuantityOnHand}" Width="110" />
            </dg:DataGrid.Columns>
        </dg:DataGrid>
    </Grid>
</Page>
