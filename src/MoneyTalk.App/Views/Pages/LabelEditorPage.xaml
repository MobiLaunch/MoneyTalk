<Page
    x:Class="MoneyTalk.App.Views.Pages.LabelEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoneyTalk.App.Controls">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="640">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Label Editor" Style="{StaticResource PageTitleStyle}" Margin="0" />
                <Button Grid.Column="1" Content="Back" Command="{Binding GoBackCommand}" />
            </Grid>
            <TextBlock Text="Controls what's printed on item labels (Products &amp; Services → Print Label)." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />

            <CheckBox Content="Show SKU" IsChecked="{Binding ShowSku, Mode=TwoWay}" />
            <CheckBox Content="Show price" IsChecked="{Binding ShowPrice, Mode=TwoWay}" />
            <ComboBox Header="Barcode type" ItemsSource="{Binding BarcodeFormatOptions}" SelectedItem="{Binding BarcodeFormatText, Mode=TwoWay}" />

            <TextBlock Text="Preview" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}" Padding="16" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="Sample Item" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PreviewSecondaryText}" Style="{StaticResource MutedTextStyle}" />
                    <Image Source="{Binding PreviewBarcode}" Width="220" Height="70" Stretch="Uniform" />
                </StackPanel>
            </Border>

            <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedTextStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
