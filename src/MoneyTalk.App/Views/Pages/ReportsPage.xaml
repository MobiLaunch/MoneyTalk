<Page
    x:Class="MoneyTalk.App.Views.Pages.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="using:CommunityToolkit.WinUI.UI.Controls">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Reports" Style="{StaticResource PageTitleStyle}" Margin="0" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Bottom">
            <DatePicker Header="Period start" Date="{Binding RangeStart, Mode=TwoWay}" />
            <DatePicker Header="Period end / As of" Date="{Binding RangeEnd, Mode=TwoWay}" />
            <Button Content="Run Reports" Style="{StaticResource AccentButtonStyle}" Command="{Binding RunReportsCommand}" VerticalAlignment="Bottom" />
            <ProgressRing IsActive="{Binding IsBusy}" VerticalAlignment="Bottom" />
        </StackPanel>

        <Pivot Grid.Row="2">
            <PivotItem Header="Profit &amp; Loss">
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Income:" />
                                <TextBlock Text="{Binding TotalIncomeDisplay}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Gross Profit:" />
                                <TextBlock Text="{Binding GrossProfitDisplay}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Net Income:" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding NetIncomeDisplay}" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Income" Style="{StaticResource SectionHeaderStyle}" />
                        <dg:DataGrid ItemsSource="{Binding IncomeLines}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="180">
                            <dg:DataGrid.Columns>
                                <dg:DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="3*" />
                                <dg:DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*" />
                            </dg:DataGrid.Columns>
                        </dg:DataGrid>
                        <TextBlock Text="Cost of Goods Sold" Style="{StaticResource SectionHeaderStyle}" />
                        <dg:DataGrid ItemsSource="{Binding CogsLines}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="140">
                            <dg:DataGrid.Columns>
                                <dg:DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="3*" />
                                <dg:DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*" />
                            </dg:DataGrid.Columns>
                        </dg:DataGrid>
                        <TextBlock Text="Expenses" Style="{StaticResource SectionHeaderStyle}" />
                        <dg:DataGrid ItemsSource="{Binding ExpenseLines}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="220">
                            <dg:DataGrid.Columns>
                                <dg:DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="3*" />
                                <dg:DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*" />
                            </dg:DataGrid.Columns>
                        </dg:DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Balance Sheet">
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <TextBlock Text="Assets" Style="{StaticResource SectionHeaderStyle}" />
                        <dg:DataGrid ItemsSource="{Binding AssetLines}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="180">
                            <dg:DataGrid.Columns>
                                <dg:DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="3*" />
                                <dg:DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*" />
                            </dg:DataGrid.Columns>
                        </dg:DataGrid>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Total Assets:" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TotalAssetsDisplay}" FontWeight="SemiBold" />
                        </StackPanel>

                        <TextBlock Text="Liabilities" Style="{StaticResource SectionHeaderStyle}" />
                        <dg:DataGrid ItemsSource="{Binding LiabilityLines}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="180">
                            <dg:DataGrid.Columns>
                                <dg:DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="3*" />
                                <dg:DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*" />
                            </dg:DataGrid.Columns>
                        </dg:DataGrid>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Total Liabilities:" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TotalLiabilitiesDisplay}" FontWeight="SemiBold" />
                        </StackPanel>

                        <TextBlock Text="Equity" Style="{StaticResource SectionHeaderStyle}" />
                        <dg:DataGrid ItemsSource="{Binding EquityLines}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="140">
                            <dg:DataGrid.Columns>
                                <dg:DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="3*" />
                                <dg:DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*" />
                            </dg:DataGrid.Columns>
                        </dg:DataGrid>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Retained Earnings:" />
                            <TextBlock Text="{Binding RetainedEarningsDisplay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Total Equity:" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TotalEquityDisplay}" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Trial Balance">
                <StackPanel Spacing="12">
                    <dg:DataGrid ItemsSource="{Binding TrialBalanceLines}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                        <dg:DataGrid.Columns>
                            <dg:DataGridTextColumn Header="Code" Binding="{Binding AccountCode}" Width="90" />
                            <dg:DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="2*" />
                            <dg:DataGridTextColumn Header="Debit" Binding="{Binding Debit}" Width="*" />
                            <dg:DataGridTextColumn Header="Credit" Binding="{Binding Credit}" Width="*" />
                        </dg:DataGrid.Columns>
                    </dg:DataGrid>
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Total Debits:" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TrialBalanceDebitsDisplay}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Total Credits:" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TrialBalanceCreditsDisplay}" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </PivotItem>

            <PivotItem Header="Cash Flow">
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <TextBlock Text="Operating Activities" Style="{StaticResource SectionHeaderStyle}" />
                        <dg:DataGrid ItemsSource="{Binding OperatingCashFlowLines}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="180">
                            <dg:DataGrid.Columns>
                                <dg:DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="3*" />
                                <dg:DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*" />
                            </dg:DataGrid.Columns>
                        </dg:DataGrid>
                        <TextBlock Text="Investing Activities" Style="{StaticResource SectionHeaderStyle}" />
                        <dg:DataGrid ItemsSource="{Binding InvestingCashFlowLines}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="120">
                            <dg:DataGrid.Columns>
                                <dg:DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="3*" />
                                <dg:DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*" />
                            </dg:DataGrid.Columns>
                        </dg:DataGrid>
                        <TextBlock Text="Financing Activities" Style="{StaticResource SectionHeaderStyle}" />
                        <dg:DataGrid ItemsSource="{Binding FinancingCashFlowLines}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="120">
                            <dg:DataGrid.Columns>
                                <dg:DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="3*" />
                                <dg:DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*" />
                            </dg:DataGrid.Columns>
                        </dg:DataGrid>
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Net Change in Cash:" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding NetCashChangeDisplay}" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Ending Cash:" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding EndingCashDisplay}" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="AR Aging">
                <dg:DataGrid ItemsSource="{Binding ArAgingLines}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <dg:DataGrid.Columns>
                        <dg:DataGridTextColumn Header="Customer" Binding="{Binding PartyName}" Width="2*" />
                        <dg:DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="*" />
                        <dg:DataGridTextColumn Header="1-30" Binding="{Binding Days1To30}" Width="*" />
                        <dg:DataGridTextColumn Header="31-60" Binding="{Binding Days31To60}" Width="*" />
                        <dg:DataGridTextColumn Header="61-90" Binding="{Binding Days61To90}" Width="*" />
                        <dg:DataGridTextColumn Header="90+" Binding="{Binding Over90}" Width="*" />
                        <dg:DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="*" />
                    </dg:DataGrid.Columns>
                </dg:DataGrid>
            </PivotItem>

            <PivotItem Header="AP Aging">
                <dg:DataGrid ItemsSource="{Binding ApAgingLines}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <dg:DataGrid.Columns>
                        <dg:DataGridTextColumn Header="Vendor" Binding="{Binding PartyName}" Width="2*" />
                        <dg:DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="*" />
                        <dg:DataGridTextColumn Header="1-30" Binding="{Binding Days1To30}" Width="*" />
                        <dg:DataGridTextColumn Header="31-60" Binding="{Binding Days31To60}" Width="*" />
                        <dg:DataGridTextColumn Header="61-90" Binding="{Binding Days61To90}" Width="*" />
                        <dg:DataGridTextColumn Header="90+" Binding="{Binding Over90}" Width="*" />
                        <dg:DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="*" />
                    </dg:DataGrid.Columns>
                </dg:DataGrid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
