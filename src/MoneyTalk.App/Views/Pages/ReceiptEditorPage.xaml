<Page
    x:Class="MoneyTalk.App.Views.Pages.ReceiptEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoneyTalk.App.Controls">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="640">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Receipt Editor" Style="{StaticResource PageTitleStyle}" Margin="0" />
                <Button Grid.Column="1" Content="Back" Command="{Binding GoBackCommand}" />
            </Grid>
            <TextBlock Text="Controls the optional header/footer text on POS receipts — the itemized body (customer, lines, total) always prints the same way." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />

            <TextBox Header="Header line (optional)" Text="{Binding HeaderText, Mode=TwoWay}" PlaceholderText="e.g. your shop name and address" />
            <TextBox Header="Footer line (optional)" Text="{Binding FooterText, Mode=TwoWay}" PlaceholderText="e.g. return policy or thank-you note" />

            <TextBlock Text="Preview" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}" Padding="16" HorizontalAlignment="Left">
                <ItemsControl ItemsSource="{Binding PreviewLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedTextStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
