<Page
    x:Class="MoneyTalk.App.Views.Pages.CompanySettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoneyTalk.App.Controls">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="640">
            <TextBlock Text="Company Settings" Style="{StaticResource PageTitleStyle}" Margin="0" />
            <controls:BusyErrorBar IsBusy="{Binding IsBusy}" ErrorMessage="{Binding ErrorMessage}" />

            <TextBox Header="Company name" Text="{Binding Name, Mode=TwoWay}" />
            <TextBox Header="Legal name" Text="{Binding LegalName, Mode=TwoWay}" />
            <TextBox Header="EIN / Tax ID" Text="{Binding Ein, Mode=TwoWay}" />
            <TextBox Header="Address" Text="{Binding Address, Mode=TwoWay}" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Header="City" Text="{Binding City, Mode=TwoWay}" />
                <TextBox Grid.Column="1" Header="State" Text="{Binding State, Mode=TwoWay}" />
                <TextBox Grid.Column="2" Header="Postal code" Text="{Binding PostalCode, Mode=TwoWay}" />
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Header="Phone" Text="{Binding Phone, Mode=TwoWay}" />
                <TextBox Grid.Column="1" Header="Email" Text="{Binding Email, Mode=TwoWay}" />
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <NumberBox Grid.Column="0" Header="Fiscal year start month (1-12)" Value="{Binding FiscalYearStartMonth, Mode=TwoWay}" Minimum="1" Maximum="12" SpinButtonPlacementMode="Inline" />
                <NumberBox Grid.Column="1" Header="Low cash warning threshold" Value="{Binding LowCashWarningThreshold, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Inline" />
            </Grid>

            <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedTextStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
