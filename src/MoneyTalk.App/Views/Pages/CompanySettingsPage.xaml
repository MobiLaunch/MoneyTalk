<Page
    x:Class="MoneyTalk.App.Views.Pages.CompanySettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoneyTalk.App.Controls">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="640">
            <TextBlock Text="Company Settings" Style="{StaticResource PageTitleStyle}" Margin="0" />
            <controls:BusyErrorBar IsBusy="{Binding IsBusy}" ErrorMessage="{Binding ErrorMessage}" />

            <TextBox Header="Company name" Text="{Binding Name, Mode=TwoWay}" />
            <TextBox Header="Legal name" Text="{Binding LegalName, Mode=TwoWay}" />
            <TextBox Header="EIN / Tax ID" Text="{Binding Ein, Mode=TwoWay}" />
            <TextBox Header="Address" Text="{Binding Address, Mode=TwoWay}" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Header="City" Text="{Binding City, Mode=TwoWay}" />
                <TextBox Grid.Column="1" Header="State" Text="{Binding State, Mode=TwoWay}" />
                <TextBox Grid.Column="2" Header="Postal code" Text="{Binding PostalCode, Mode=TwoWay}" />
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Header="Phone" Text="{Binding Phone, Mode=TwoWay}" />
                <TextBox Grid.Column="1" Header="Email" Text="{Binding Email, Mode=TwoWay}" />
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <NumberBox Grid.Column="0" Header="Fiscal year start month (1-12)" Value="{Binding FiscalYearStartMonth, Mode=TwoWay}" Minimum="1" Maximum="12" SpinButtonPlacementMode="Inline" />
                <NumberBox Grid.Column="1" Header="Low cash warning threshold" Value="{Binding LowCashWarningThreshold, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Inline" />
            </Grid>

            <ComboBox Header="Receipt/label printer" ItemsSource="{Binding ReceiptPrinterOptions}"
                      SelectedItem="{Binding SelectedReceiptPrinter, Mode=TwoWay}" HorizontalAlignment="Stretch" />

            <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Idle Screen Lock" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="Locks the app after 3 minutes of no mouse/keyboard activity — useful on a shared shop-floor terminal." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="✓ PIN is set." Foreground="{StaticResource MoneyTalkPositiveBrush}" Visibility="{Binding HasScreenLockPin, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="Set a PIN below before turning on screen lock." Style="{StaticResource MutedTextStyle}" Visibility="{Binding HasScreenLockPin, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                    <ToggleSwitch Header="Enable idle screen lock" IsOn="{Binding ScreenLockEnabled, Mode=TwoWay}" />

                    <PasswordBox Header="New PIN (4-6 digits)" Password="{Binding NewPinInput, Mode=TwoWay}" MaxLength="6" />
                    <PasswordBox Header="Confirm PIN" Password="{Binding ConfirmPinInput, Mode=TwoWay}" MaxLength="6" />
                    <Button Content="Set PIN" Command="{Binding SetPinCommand}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding PinStatusMessage}" Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
