<Page
    x:Class="MoneyTalk.App.Views.Pages.UsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="using:CommunityToolkit.WinUI.UI.Controls">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Users" Style="{StaticResource PageTitleStyle}" Margin="0" />
            <Button Grid.Column="1" Content="Add User" Style="{StaticResource AccentButtonStyle}" Click="AddUser_Click" VerticalAlignment="Center" />
        </Grid>

        <dg:DataGrid Grid.Row="1" ItemsSource="{Binding Users}" AutoGenerateColumns="False"
                     IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <dg:DataGrid.Columns>
                <dg:DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
                <dg:DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220" />
                <dg:DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="140" />
                <dg:DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70" />
                <dg:DataGridTemplateColumn Header="" Width="90">
                    <dg:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Toggle" Click="ToggleActive_Click" Tag="{Binding}" />
                        </DataTemplate>
                    </dg:DataGridTemplateColumn.CellTemplate>
                </dg:DataGridTemplateColumn>
            </dg:DataGrid.Columns>
        </dg:DataGrid>
    </Grid>
</Page>
