<Page
    x:Class="MoneyTalk.App.Views.Pages.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" Spacing="16">
            <TextBlock Text="Welcome to MoneyTalk" Style="{StaticResource PageTitleStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="Let's set up your company. MoneyTalk will create a standard chart of accounts, a default bank account, and a tax rate you can customize any time."
                       TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" />

            <TextBox Header="Company name" PlaceholderText="e.g. Riverside Coffee Co."
                     Text="{Binding CompanyName, Mode=TwoWay}" />

            <InfoBar IsOpen="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error" Message="{Binding ErrorMessage}" />

            <Button Content="Create Company" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding CreateCompanyCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />

            <ProgressRing IsActive="{Binding IsBusy}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
