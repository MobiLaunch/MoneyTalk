<Page
    x:Class="MoneyTalk.App.Views.Pages.TicketsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:controls="using:MoneyTalk.App.Controls">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Repair Tickets" Style="{StaticResource PageTitleStyle}" Margin="0" />
            <Button Grid.Column="1" Content="New Ticket" Style="{StaticResource AccentButtonStyle}" Command="{Binding NewTicketCommand}" VerticalAlignment="Center" />
        </Grid>

        <controls:BusyErrorBar Grid.Row="1" IsBusy="{Binding IsBusy}" ErrorMessage="{Binding ErrorMessage}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <ComboBox Header="Status" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}" MinWidth="180" />
            <TextBox Header="Search" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Ticket #, device, issue, serial..." MinWidth="280" />
        </StackPanel>

        <Grid Grid.Row="3">
            <dg:DataGrid ItemsSource="{Binding Tickets}" AutoGenerateColumns="False"
                         IsReadOnly="True" SelectedItem="{Binding SelectedTicket, Mode=TwoWay}"
                         GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                         DoubleTapped="Grid_DoubleTapped">
                <dg:DataGrid.Columns>
                    <dg:DataGridTextColumn Header="Ticket #" Binding="{Binding TicketNumber}" Width="110" />
                    <dg:DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="160" />
                    <dg:DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="180" />
                    <dg:DataGridTextColumn Header="Issue" Binding="{Binding Issue}" Width="200" />
                    <dg:DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="90" />
                    <dg:DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140" />
                    <dg:DataGridTextColumn Header="Age (days)" Binding="{Binding AgeDays}" Width="90" />
                    <dg:DataGridTextColumn Header="Balance" Binding="{Binding Balance}" Width="110" />
                </dg:DataGrid.Columns>
            </dg:DataGrid>
            <TextBlock Text="No tickets match. Click &quot;New Ticket&quot; to create one." Style="{StaticResource MutedTextStyle}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Tickets.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}" />
        </Grid>
    </Grid>
</Page>
