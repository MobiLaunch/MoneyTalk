<Page
    x:Class="MoneyTalk.App.Views.Pages.RecurringTransactionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:controls="using:MoneyTalk.App.Controls">

    <Grid Padding="24" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1.2*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Recurring Transactions" Style="{StaticResource PageTitleStyle}" Margin="0" />
            <Button Grid.Row="1" Content="Run Due Transactions Now" Command="{Binding RunDueNowCommand}" HorizontalAlignment="Left" />

            <Grid Grid.Row="2">
                <dg:DataGrid ItemsSource="{Binding RecurringTransactions}" AutoGenerateColumns="False"
                             IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <dg:DataGrid.Columns>
                        <dg:DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
                        <dg:DataGridTextColumn Header="Type" Binding="{Binding TemplateType}" Width="110" />
                        <dg:DataGridTextColumn Header="Frequency" Binding="{Binding Frequency}" Width="110" />
                        <dg:DataGridTextColumn Header="Next Run" Binding="{Binding NextRunDate}" Width="120" />
                        <dg:DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70" />
                        <dg:DataGridTemplateColumn Header="" Width="90">
                            <dg:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Toggle" Click="ToggleActive_Click" Tag="{Binding}" />
                                </DataTemplate>
                            </dg:DataGridTemplateColumn.CellTemplate>
                        </dg:DataGridTemplateColumn>
                    </dg:DataGrid.Columns>
                </dg:DataGrid>
                <TextBlock Text="No recurring transactions yet. Compose one on the right." Style="{StaticResource MutedTextStyle}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding RecurringTransactions.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}" />
            </Grid>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
            <StackPanel Spacing="12">
                <TextBlock Text="New Recurring Journal Entry" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock Text="For recurring rent, depreciation, accruals, or any transaction with the same accounts every period. Recurring invoices/bills are created from the Invoices/Bills pages by re-using a saved draft."
                           TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" />
                <controls:BusyErrorBar IsBusy="{Binding IsBusy}" ErrorMessage="{Binding ErrorMessage}" />

                <TextBox Header="Name" Text="{Binding NewTemplateName, Mode=TwoWay}" />
                <DatePicker Header="First run date" Date="{Binding NewTemplateStartDate, Mode=TwoWay}" />
                <ComboBox Header="Frequency" ItemsSource="{Binding FrequencyOptions}" SelectedIndex="{Binding SelectedFrequencyIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />

                <Button Content="Add Line" Click="AddLine_Click" HorizontalAlignment="Left" />

                <dg:DataGrid ItemsSource="{Binding NewTemplateLines}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MinHeight="120" MaxHeight="200">
                    <dg:DataGrid.Columns>
                        <dg:DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="2*" />
                        <dg:DataGridTextColumn Header="Debit" Binding="{Binding Debit}" Width="*" />
                        <dg:DataGridTextColumn Header="Credit" Binding="{Binding Credit}" Width="*" />
                    </dg:DataGrid.Columns>
                </dg:DataGrid>

                <Button Content="Create Recurring Entry" Style="{StaticResource AccentButtonStyle}" Command="{Binding CreateRecurringJournalEntryCommand}" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
