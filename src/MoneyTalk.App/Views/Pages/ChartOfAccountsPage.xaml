<Page
    x:Class="MoneyTalk.App.Views.Pages.ChartOfAccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="using:CommunityToolkit.WinUI.Controls">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Chart of Accounts" Style="{StaticResource PageTitleStyle}" Margin="0" />
            <Button Grid.Column="1" Content="Add Account" Style="{StaticResource AccentButtonStyle}" Click="AddAccount_Click" VerticalAlignment="Center" />
        </Grid>

        <InfoBar Grid.Row="1" IsOpen="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" Severity="Error" Message="{Binding ErrorMessage}" />

        <dg:DataGrid Grid.Row="2" ItemsSource="{Binding Accounts}" AutoGenerateColumns="False"
                     IsReadOnly="True" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                     GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <dg:DataGrid.Columns>
                <dg:DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90" />
                <dg:DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="260" />
                <dg:DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="140" />
                <dg:DataGridTextColumn Header="Sub-Type" Binding="{Binding SubType}" Width="180" />
                <dg:DataGridTextColumn Header="Balance" Binding="{Binding CurrentBalance}" Width="140" />
                <dg:DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80" />
            </dg:DataGrid.Columns>
        </dg:DataGrid>
    </Grid>
</Page>
