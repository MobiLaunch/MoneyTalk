<Page
    x:Class="MoneyTalk.App.Views.Pages.DeviceTriagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:controls="using:MoneyTalk.App.Controls">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Device Triage" Style="{StaticResource PageTitleStyle}" Margin="0" />
            <Button Grid.Column="1" Content="Add Device" Style="{StaticResource AccentButtonStyle}" Click="AddRecord_Click" VerticalAlignment="Center" />
        </Grid>

        <TextBlock Grid.Row="1" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap">
            Tracks devices through intake → backup → diagnostics → restore. No third-party Windows
            app can trigger a backup, diagnostic, or OS update on a connected iPhone, Mac, or
            Chromebook — that's never exposed to outside software by Apple, Google, or Microsoft —
            so those platforms get a checklist plus a button to launch whatever native tool that
            platform actually offers. Android has an open USB protocol (ADB) this app can genuinely
            drive for real diagnostics and backup — see the Android Tools section below.
        </TextBlock>

        <controls:BusyErrorBar Grid.Row="2" IsBusy="{Binding IsBusy}" ErrorMessage="{Binding ErrorMessage}" />

        <Grid Grid.Row="3">
            <dg:DataGrid ItemsSource="{Binding Records}" AutoGenerateColumns="False"
                         IsReadOnly="True" SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                         GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                         DoubleTapped="Grid_DoubleTapped">
                <dg:DataGrid.Columns>
                    <dg:DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="100" />
                    <dg:DataGridTextColumn Header="Device" Binding="{Binding DeviceLabel}" Width="200" />
                    <dg:DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="140" />
                    <dg:DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                    <dg:DataGridTextColumn Header="Backup" Binding="{Binding BackupCompleted}" Width="70" />
                    <dg:DataGridTextColumn Header="Diagnostics" Binding="{Binding DiagnosticsCompleted}" Width="90" />
                    <dg:DataGridTextColumn Header="Restore" Binding="{Binding RestoreCompleted}" Width="70" />
                    <dg:DataGridTextColumn Header="OS Detected" Binding="{Binding OsVersionDetected}" Width="140" />
                </dg:DataGrid.Columns>
            </dg:DataGrid>
            <TextBlock Text="No devices tracked yet. Click &quot;Add Device&quot; to start one." Style="{StaticResource MutedTextStyle}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Records.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}" />
        </Grid>

        <StackPanel Grid.Row="4" Spacing="10">
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Native Tool" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="Opens the platform's own backup/settings tool for the selected device above (select a row first)." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <Button Content="Launch Native Tool for Selected Device" Command="{Binding LaunchNativeToolCommand}" CommandParameter="{Binding SelectedRecord.Platform}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Android Tools (via ADB)" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="Requires Android SDK Platform Tools installed and USB debugging enabled on the device. Results save to whichever device row is selected above." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="adb.exe wasn't found — install Android SDK Platform Tools from developer.android.com/tools/releases/platform-tools." Foreground="{StaticResource MoneyTalkWarningBrush}" TextWrapping="Wrap"
                               Visibility="{Binding IsAdbAvailable, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Refresh Devices" Command="{Binding RefreshAndroidDevicesCommand}" />
                        <ComboBox Header="Connected device" ItemsSource="{Binding AndroidDevices}" SelectedItem="{Binding SelectedAndroidDevice, Mode=TwoWay}"
                                  DisplayMemberPath="Serial" MinWidth="220" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Run Diagnostics" Command="{Binding RunAndroidDiagnosticsCommand}" />
                        <Button Content="Back Up Device" Click="BackUpAndroidDevice_Click" />
                    </StackPanel>
                    <TextBlock Text="{Binding AndroidStatusMessage}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
