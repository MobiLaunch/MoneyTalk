<Page
    x:Class="MoneyTalk.App.Views.Pages.VendorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:controls="using:MoneyTalk.App.Controls">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Vendors" Style="{StaticResource PageTitleStyle}" Margin="0" />
            <Button Grid.Column="1" Content="New Bill" Margin="0,0,8,0" Command="{Binding NewBillForSelectedCommand}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Add Vendor" Style="{StaticResource AccentButtonStyle}" Click="AddVendor_Click" VerticalAlignment="Center" />
        </Grid>

        <controls:BusyErrorBar Grid.Row="1" IsBusy="{Binding IsBusy}" ErrorMessage="{Binding ErrorMessage}" />

        <Grid Grid.Row="2">
            <dg:DataGrid ItemsSource="{Binding Vendors}" AutoGenerateColumns="False"
                         IsReadOnly="True" SelectedItem="{Binding SelectedVendor, Mode=TwoWay}"
                         GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                         DoubleTapped="VendorsGrid_DoubleTapped">
                <dg:DataGrid.Columns>
                    <dg:DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" />
                    <dg:DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220" />
                    <dg:DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="150" />
                    <dg:DataGridTextColumn Header="Terms (days)" Binding="{Binding PaymentTermsDays}" Width="110" />
                    <dg:DataGridCheckBoxColumn Header="1099" Binding="{Binding Is1099Vendor}" Width="70" />
                    <dg:DataGridTextColumn Header="Balance" Binding="{Binding Balance}" Width="140" />
                </dg:DataGrid.Columns>
            </dg:DataGrid>
            <TextBlock Text="No vendors yet. Click &quot;Add Vendor&quot; to create one." Style="{StaticResource MutedTextStyle}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Vendors.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}" />
        </Grid>
    </Grid>
</Page>
