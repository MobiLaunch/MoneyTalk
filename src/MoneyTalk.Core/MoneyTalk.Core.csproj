<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MoneyTalk.Core</RootNamespace>
    <AssemblyName>MoneyTalk.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- SMTP notification emails (see EmailService) — MailKit rather than the obsolete
         System.Net.Mail.SmtpClient. -->
    <PackageReference Include="MailKit" Version="4.9.0" />
  </ItemGroup>

</Project>
